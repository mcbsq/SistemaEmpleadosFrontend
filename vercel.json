{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://sistema-empleados-backend.vercel.app/:path*"
    },
    {
      "source": "/static/(.*)",
      "destination": "/static/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
